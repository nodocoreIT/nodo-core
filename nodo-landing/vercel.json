{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter nodo-inmo --filter nodo-autos --filter nodo-finanzas build && pnpm build",
  "crons": [
    {
      "path": "/api/cron/backup-orgs",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/refresh-fx-rate",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/generate-rent-installments",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-task-notification-emails",
      "schedule": "0 12 * * *"
    }
  ]
}
